<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ShopNest</title>

    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet" />

    <!-- Dark Mode Theme Checker & Override styles -->
    <script>
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <style>
        /* Dark Mode CSS Variables & Generic Overrides */
        html.dark,
        html.dark body {
            background-color: #0b0f19 !important;
            color: #f1f5f9 !important;
        }

        html.dark nav {
            background-color: rgba(15, 23, 42, 0.8) !important;
            border-color: #1e293b !important;
        }

        html.dark nav span,
        html.dark nav a {
            color: #f1f5f9 !important;
        }

        html.dark nav a:hover {
            color: #3b82f6 !important;
        }

        html.dark .bg-white {
            background-color: #151c2c !important;
        }

        html.dark .bg-gray-50,
        html.dark .bg-gray-50\/50,
        html.dark .container.bg-white,
        html.dark main.bg-white {
            background-color: #0f172a !important;
        }

        html.dark .text-gray-900 {
            color: #f8fafc !important;
        }

        html.dark .text-gray-800 {
            color: #e2e8f0 !important;
        }

        html.dark .text-gray-700 {
            color: #cbd5e1 !important;
        }

        html.dark .text-gray-600 {
            color: #94a3b8 !important;
        }

        html.dark .text-gray-500 {
            color: #64748b !important;
        }

        html.dark .text-gray-400 {
            color: #475569 !important;
        }

        html.dark .border,
        html.dark .border-gray-100,
        html.dark .border-gray-200,
        html.dark .border-gray-300 {
            border-color: #1e293b !important;
        }

        html.dark .bg-gray-50 {
            background-color: #1e293b !important;
        }

        html.dark .bg-blue-50 {
            background-color: #1e3a8a !important;
            color: #60a5fa !important;
        }

        html.dark .text-blue-600 {
            color: #60a5fa !important;
        }

        html.dark .shadow-sm,
        html.dark .shadow,
        html.dark .shadow-md,
        html.dark .shadow-lg,
        html.dark .shadow-xl,
        html.dark .shadow-2xl {
            box-shadow: 0 4px 20px 0 rgba(0, 0, 0, 0.4) !important;
        }

        html.dark footer {
            background-color: #080c14 !important;
            border-top: 1px solid #1e293b !important;
        }

        html.dark input,
        html.dark select,
        html.dark textarea {
            background-color: #1e293b !important;
            border-color: #334155 !important;
            color: #f1f5f9 !important;
        }

        html.dark select option {
            background-color: #1e293b !important;
            color: #f1f5f9 !important;
        }

        html.dark .toast {
            background-color: #1e293b !important;
            border-color: #334155 !important;
        }

        html.dark .bg-gray-100 {
            background-color: #1e293b !important;
            color: #e2e8f0 !important;
        }

        html.dark aside.bg-white,
        html.dark form input {
            background-color: #151c2c !important;
        }

        html.dark form input:focus {
            background-color: #151c2c !important;
        }

        html.dark .bg-gray-50 {
            background-color: #151c2c !important;
        }

        html.dark .bg-blue-500 {
            background-color: #3b82f6 !important;
        }
    </style>
</head>

<body class="font-['Helvetica'] bg-slate-50">

    <% var loggedin=typeof loggedin !=="undefined" ? loggedin : true; %>

        <nav class="w-full fixed top-0 left-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200">

            <div class="max-w-7xl mx-auto flex justify-between items-center px-4 md:px-8 py-4 md:py-5 ">

                <a href="/" class="flex items-center gap-2">

                    <i class="ri-shopping-bag-3-fill text-2xl md:text-3xl text-blue-600"></i>

                    <span class="text-xl md:text-2xl font-bold text-gray-800">
                        ShopNest
                    </span>

                </a>

                <% if(loggedin){ %>

                    <!-- Desktop Nav -->
                    <div class="hidden md:flex items-center gap-8">

                        <a href="/shop" class="font-medium hover:text-blue-600 transition">
                            Shop
                        </a>

                        <a href="/cart" class="font-medium hover:text-blue-600 transition">
                            Cart
                        </a>

                        <a href="/orders/my-orders" class="font-medium hover:text-blue-600 transition">
                            My Orders
                        </a>

                        <a href="/users/profile" class="font-medium hover:text-blue-600 transition">
                            My Account
                        </a>

                        <button id="theme-toggle-nav"
                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 hover:bg-gray-200 transition-colors cursor-pointer text-gray-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300">
                            <i class="theme-toggle-icon ri-moon-line text-lg"></i>
                        </button>

                        <a href="/users/logout"
                            class="px-4 py-2 rounded-lg bg-red-500 hover:bg-red-600 text-white transition">
                            Logout
                        </a>

                    </div>

                    <!-- Mobile Hamburger Button -->
                    <button id="mobile-menu-btn"
                        class="md:hidden w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 hover:bg-gray-200 transition-colors cursor-pointer text-gray-700">
                        <i id="hamburger-icon" class="ri-menu-3-line text-xl"></i>
                    </button>

                    <% } else { %>
                        <div class="flex items-center gap-4">
                            <button id="theme-toggle-guest"
                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 hover:bg-gray-200 transition-colors cursor-pointer text-gray-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300">
                                <i class="theme-toggle-icon ri-moon-line text-lg"></i>
                            </button>
                        </div>
                        <% } %>

            </div>

            <!-- Mobile Menu Dropdown -->
            <% if(loggedin){ %>
                <div id="mobile-menu" class="md:hidden hidden border-t border-gray-200 bg-white/95 backdrop-blur-md">
                    <div class="flex flex-col px-4 py-3 gap-1">
                        <a href="/shop"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="ri-store-2-line text-lg"></i> Shop
                        </a>
                        <a href="/cart"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="ri-shopping-cart-line text-lg"></i> Cart
                        </a>
                        <a href="/orders/my-orders"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="ri-file-list-3-line text-lg"></i> My Orders
                        </a>
                        <a href="/users/profile"
                            class="flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="ri-user-line text-lg"></i> My Account
                        </a>
                        <div class="flex items-center gap-3 px-4 py-3">
                            <button id="theme-toggle-mobile"
                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 hover:bg-gray-200 transition-colors cursor-pointer text-gray-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300">
                                <i class="theme-toggle-icon ri-moon-line text-lg"></i>
                            </button>
                            <a href="/users/logout"
                                class="flex-1 text-center px-4 py-2.5 rounded-xl bg-red-500 hover:bg-red-600 text-white font-medium transition">
                                Logout
                            </a>
                        </div>
                    </div>
                </div>
                <% } %>

        </nav>

        <!-- Navbar Spacer -->
        <div class="h-20"></div>

        <!-- Global Toasts -->
        <div id="toast-container"
            class="fixed top-24 left-1/2 -translate-x-1/2 z-[100] flex flex-col gap-3 pointer-events-none">
            <% if (typeof success !=='undefined' && success && success.length> 0) { %>
                <div
                    class="toast bg-gray-900/95 backdrop-blur text-white px-6 py-3 rounded-2xl shadow-2xl flex items-center gap-3 animate-fade-in-down border border-gray-700 pointer-events-auto">
                    <div
                        class="w-8 h-8 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center shrink-0">
                        <i class="ri-check-line text-lg"></i>
                    </div>
                    <p class="font-medium text-sm">
                        <%= success %>
                    </p>
                    <button onclick="this.parentElement.remove()"
                        class="ml-4 text-gray-400 hover:text-white transition-colors">
                        <i class="ri-close-line"></i>
                    </button>
                </div>
                <% } %>

                    <% if (typeof error !=='undefined' && error && error.length> 0) { %>
                        <div
                            class="toast bg-gray-900/95 backdrop-blur text-white px-6 py-3 rounded-2xl shadow-2xl flex items-center gap-3 animate-fade-in-down border border-gray-700 pointer-events-auto">
                            <div
                                class="w-8 h-8 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center shrink-0">
                                <i class="ri-error-warning-line text-lg"></i>
                            </div>
                            <p class="font-medium text-sm">
                                <%= error %>
                            </p>
                            <button onclick="this.parentElement.remove()"
                                class="ml-4 text-gray-400 hover:text-white transition-colors">
                                <i class="ri-close-line"></i>
                            </button>
                        </div>
                        <% } %>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    document.querySelectorAll('.toast').forEach(toast => {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateY(-20px)';
                        toast.style.transition = 'all 0.5s ease-out';
                        setTimeout(() => toast.remove(), 500);
                    });
                }, 3500);

                // Mobile menu toggle
                const mobileMenuBtn = document.getElementById('mobile-menu-btn');
                const mobileMenu = document.getElementById('mobile-menu');
                const hamburgerIcon = document.getElementById('hamburger-icon');
                if (mobileMenuBtn && mobileMenu) {
                    mobileMenuBtn.addEventListener('click', () => {
                        mobileMenu.classList.toggle('hidden');
                        if (mobileMenu.classList.contains('hidden')) {
                            hamburgerIcon.classList.remove('ri-close-line');
                            hamburgerIcon.classList.add('ri-menu-3-line');
                        } else {
                            hamburgerIcon.classList.remove('ri-menu-3-line');
                            hamburgerIcon.classList.add('ri-close-line');
                        }
                    });
                }

                const toggleButtons = [document.getElementById('theme-toggle-nav'), document.getElementById('theme-toggle-guest'), document.getElementById('theme-toggle-mobile')];
                const icons = document.querySelectorAll('.theme-toggle-icon');

                function updateIcons() {
                    const isDark = document.documentElement.classList.contains('dark');
                    icons.forEach(icon => {
                        if (isDark) {
                            icon.classList.remove('ri-moon-line');
                            icon.classList.add('ri-sun-line');
                        } else {
                            icon.classList.remove('ri-sun-line');
                            icon.classList.add('ri-moon-line');
                        }
                    });
                }

                updateIcons();

                toggleButtons.forEach(btn => {
                    if (btn) {
                        btn.addEventListener('click', () => {
                            const isDark = document.documentElement.classList.toggle('dark');
                            localStorage.setItem('theme', isDark ? 'dark' : 'light');
                            updateIcons();
                        });
                    }
                });
            });
        </script>

        <style>
            @keyframes fadeInDown {
                from {
                    opacity: 0;
                    transform: translateY(-20px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            .animate-fade-in-down {
                animation: fadeInDown 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            }
        </style>