<!-- Global Loading Overlay -->
<div id="globalLoader"
    class="fixed inset-0 bg-white/80 backdrop-blur z-[9999] opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col items-center justify-center">
    <div
        class="w-16 h-16 border-4 border-blue-500 border-t-transparent border-dashed rounded-full animate-spin shadow-lg">
    </div>
    <span class="mt-4 text-blue-600 font-bold tracking-widest uppercase text-sm animate-pulse">Loading...</span>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const loader = document.getElementById('globalLoader');

        document.querySelectorAll('a').forEach(anchor => {
            anchor.addEventListener('click', (e) => {
                if (anchor.href && !anchor.href.includes('#') && !anchor.href.includes('javascript:') && anchor.target !== '_blank' && !anchor.getAttribute('download')) {
                    loader.classList.remove('opacity-0', 'pointer-events-none');
                    loader.classList.add('opacity-100');
                }
            });
        });

        document.querySelectorAll('form').forEach(form => {
            form.addEventListener('submit', () => {
                loader.classList.remove('opacity-0', 'pointer-events-none');
                loader.classList.add('opacity-100');
            });
        });

        window.addEventListener('pageshow', (e) => {
            if (e.persisted) {
                loader.classList.add('opacity-0', 'pointer-events-none');
                loader.classList.remove('opacity-100');
            }
        });
    });
</script>
