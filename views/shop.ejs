<%- include('./partials/header') %>

    <div class="w-full min-h-screen bg-gray-50 flex flex-col pt-24 px-4 md:px-10 lg:px-20 pb-20">

        <!-- ── Personalized Greeting Banner ── -->
        <div
            class="flex items-center justify-between bg-white rounded-2xl border border-gray-100 shadow-sm px-6 py-4 mb-6">
            <div class="flex items-center gap-4">
                <!-- Avatar -->
                <a href="/users/profile" class="shrink-0">
                    <div
                        class="w-12 h-12 rounded-full overflow-hidden bg-blue-100 flex items-center justify-center ring-2 ring-blue-100 hover:ring-blue-300 transition-all shadow-sm">
                        <% if (user.picture) { %>
                            <img src="<%= user.picture %>" alt="Profile" class="w-full h-full object-cover">
                            <% } else { %>
                                <span class="text-lg font-extrabold text-blue-500">
                                    <%= user.fullname ? user.fullname.charAt(0).toUpperCase() : 'U' %>
                                </span>
                                <% } %>
                    </div>
                </a>
                <!-- Greeting Text -->
                <div>
                    <p class="text-xs text-gray-400 font-medium uppercase tracking-wider" id="greeting-time">Good day
                    </p>
                    <h2 class="text-lg font-extrabold text-gray-900 leading-tight">Hello, <%= user.fullname ?
                            user.fullname.split(' ')[0] : ' there' %>! 👋</h2>
                </div>
            </div>
            <!-- Right: small tagline -->
            <p class="hidden sm:block text-sm text-gray-400 font-medium italic">Discover something new today ✨</p>
        </div>

        <!-- Mobile Category Filter -->
        <div class="md:hidden flex gap-2 overflow-x-auto pb-2 mb-2 -mx-1 px-1 scrollbar-none">
            <a href="/shop?category=all&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                class="shrink-0 px-4 py-2 rounded-full text-sm font-semibold transition-all <%= currentCategory === 'all' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">All</a>
            <a href="/shop?category=Fashion&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                class="shrink-0 px-4 py-2 rounded-full text-sm font-semibold transition-all <%= currentCategory === 'Fashion' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">Fashion</a>
            <a href="/shop?category=Electronics&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                class="shrink-0 px-4 py-2 rounded-full text-sm font-semibold transition-all <%= currentCategory === 'Electronics' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">Electronics</a>
            <a href="/shop?category=Accessories&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                class="shrink-0 px-4 py-2 rounded-full text-sm font-semibold transition-all <%= currentCategory === 'Accessories' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">Accessories</a>
            <a href="/shop?category=Footwear&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                class="shrink-0 px-4 py-2 rounded-full text-sm font-semibold transition-all <%= currentCategory === 'Footwear' ? 'bg-blue-600 text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:bg-gray-50' %>">Footwear</a>
        </div>
        <style>
            .scrollbar-none::-webkit-scrollbar {
                display: none;
            }

            .scrollbar-none {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
        </style>

        <div class="flex flex-col md:flex-row gap-8">

            <!-- Sidebar Filters -->
            <aside
                class="w-full md:w-1/4 lg:w-1/5 shrink-0 bg-white p-6 rounded-2xl shadow-sm border border-gray-100 h-fit sticky top-24 hidden md:block">
                <h3 class="font-bold text-xl mb-6 text-gray-800">Categories</h3>
                <div class="flex flex-col gap-3">
                    <a href="/shop?category=all&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                        class="px-4 py-2 rounded-lg transition-all <%= currentCategory === 'all' ? 'bg-blue-50 text-blue-600 font-semibold' : 'text-gray-600 hover:bg-gray-50' %>">All
                        Products</a>
                    <a href="/shop?category=Fashion&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                        class="px-4 py-2 rounded-lg transition-all <%= currentCategory === 'Fashion' ? 'bg-blue-50 text-blue-600 font-semibold' : 'text-gray-600 hover:bg-gray-50' %>">Fashion</a>
                    <a href="/shop?category=Electronics&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                        class="px-4 py-2 rounded-lg transition-all <%= currentCategory === 'Electronics' ? 'bg-blue-50 text-blue-600 font-semibold' : 'text-gray-600 hover:bg-gray-50' %>">Electronics</a>
                    <a href="/shop?category=Accessories&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                        class="px-4 py-2 rounded-lg transition-all <%= currentCategory === 'Accessories' ? 'bg-blue-50 text-blue-600 font-semibold' : 'text-gray-600 hover:bg-gray-50' %>">Accessories</a>
                    <a href="/shop?category=Footwear&sortby=<%= currentSort %>&search=<%= searchQuery %>"
                        class="px-4 py-2 rounded-lg transition-all <%= currentCategory === 'Footwear' ? 'bg-blue-50 text-blue-600 font-semibold' : 'text-gray-600 hover:bg-gray-50' %>">Footwear</a>
                </div>
            </aside>

            <!-- Main Product Area -->
            <main class="w-full md:w-3/4 lg:w-4/5 flex flex-col gap-6">

                <!-- Top Controls Layer -->
                <div
                    class="flex flex-col lg:flex-row items-center justify-between bg-white p-4 rounded-2xl shadow-sm border border-gray-100 gap-4">

                    <!-- Search Form -->
                    <form action="/shop" class="flex-1 w-full relative">
                        <input type="hidden" name="category" value="<%= currentCategory %>">
                        <input type="hidden" name="sortby" value="<%= currentSort %>">
                        <div class="relative w-full lg:max-w-md">
                            <i class="ri-search-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>
                            <input type="text" name="search" value="<%= searchQuery %>"
                                placeholder="Search products, brands, or categories..."
                                class="w-full bg-gray-50 hover:bg-gray-100 transition-colors py-3 pl-10 pr-4 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white text-sm">
                        </div>
                    </form>

                    <!-- Sorting -->
                    <form action="/shop" class="w-full lg:w-fit flex items-center justify-end gap-3">
                        <input type="hidden" name="category" value="<%= currentCategory %>">
                        <input type="hidden" name="search" value="<%= searchQuery %>">
                        <span class="text-sm font-medium text-gray-500 whitespace-nowrap">Sort by:</span>
                        <select onchange="this.form.submit()" name="sortby"
                            class="bg-gray-50 hover:bg-gray-100 transition-colors py-2 px-4 rounded-xl outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white text-sm font-medium text-gray-700 cursor-pointer w-full lg:w-auto appearance-none pr-10 relative bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23131313%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E')] bg-no-repeat bg-[right_1rem_center] bg-[length:0.65rem_auto]">
                            <option value="" <%=currentSort==='' ? 'selected' : '' %>>Featured</option>
                            <option value="newest" <%=currentSort==='newest' ? 'selected' : '' %>>Newest
                                Arrivals</option>
                            <option value="price-low-high" <%=currentSort==='price-low-high' ? 'selected' : '' %>>Price:
                                Low to High</option>
                            <option value="price-high-low" <%=currentSort==='price-high-low' ? 'selected' : '' %>>Price:
                                High to Low</option>
                            <option value="highest-discount" <%=currentSort==='highest-discount' ? 'selected' : '' %>
                                >Highest Discount</option>
                        </select>
                    </form>
                </div>

                <!-- Product Grid -->
                <% if (products.length> 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        <% products.forEach(function(product){ %>
                            <div
                                class="group flex flex-col bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 relative border border-gray-100">

                                <!-- Wishlist Icon hover -->
                                <button
                                    class="absolute top-4 right-4 z-10 w-9 h-9 flex items-center justify-center bg-white/80 backdrop-blur rounded-full shadow hover:bg-red-50 hover:text-red-500 transition-colors opacity-0 group-hover:opacity-100">
                                    <i class="ri-heart-3-line text-xl"></i>
                                </button>

                                <!-- Discount Badge -->
                                <% if(product.discount> 0) { %>
                                    <div class="absolute top-4 left-4 z-10">
                                        <span
                                            class="bg-red-500 text-white text-xs font-bold px-2 py-1 rounded-md shadow-md">
                                            -₹<%= product.discount %>
                                        </span>
                                    </div>
                                    <% } %>

                                        <!-- Product Image Box -->
                                        <a href="/product/<%= product._id %>"
                                            class="w-full h-56 flex items-center justify-center overflow-hidden relative"
                                            style="background-color: <%= product.bgcolor %>">
                                            <img class="h-4/5 object-contain transform group-hover:scale-110 transition-transform duration-500 drop-shadow-lg p-4"
                                                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                                alt="<%= product.name %>">

                                            <!-- Overlay for "View Details" hint -->
                                            <div
                                                class="absolute inset-0 bg-black/5 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                                                <span
                                                    class="bg-white/95 text-gray-900 text-xs font-bold uppercase tracking-wider px-4 py-2 rounded-full shadow-lg transform translate-y-4 group-hover:translate-y-0 transition-all duration-300">View
                                                    Details</span>
                                            </div>
                                        </a>

                                        <!-- Product Details Box -->
                                        <div class="p-5 flex flex-col flex-1"
                                            style="background-color: <%= product.panelcolor || '#ffffff' %>;">

                                            <!-- Category / Brand snippet -->
                                            <div class="flex justify-between items-center mb-1">
                                                <span
                                                    class="text-xs font-semibold uppercase tracking-wider text-gray-400">
                                                    <%= product.category || 'Product' %>
                                                </span>
                                                <% if (product.stock> 0) { %>
                                                    <span
                                                        class="w-2 h-2 rounded-full bg-green-500 shadow-sm shadow-green-200"></span>
                                                    <% } else { %>
                                                        <span
                                                            class="text-[0.65rem] font-bold text-red-500 bg-red-50 px-1 rounded">OUT</span>
                                                        <% } %>
                                            </div>

                                            <a href="/product/<%= product._id %>" class="block">
                                                <h3 class="font-bold text-lg leading-tight mb-2 truncate"
                                                    style="color: <%= product.textcolor || '#1a1a1a' %>">
                                                    <%= product.name %>
                                                </h3>
                                            </a>

                                            <div class="flex items-end gap-2 mt-auto">
                                                <h4 class="font-bold text-xl text-gray-900">₹<%= (product.price -
                                                        product.discount).toLocaleString() %>
                                                </h4>
                                                <% if(product.discount> 0) { %>
                                                    <span class="text-xs font-medium text-gray-400 line-through mb-1">₹
                                                        <%= product.price.toLocaleString() %>
                                                    </span>
                                                    <% } %>
                                            </div>

                                            <div
                                                class="mt-4 pt-4 border-t border-gray-100 flex items-center justify-between">
                                                <% if(product.stock> 0) { %>
                                                    <a href="/addtocart/<%= product._id %>"
                                                        class="w-full bg-black hover:bg-gray-800 text-white flex items-center justify-center gap-2 py-2.5 rounded-xl text-sm font-semibold transition-colors">
                                                        <i class="ri-shopping-cart-line"></i> Add to Cart
                                                    </a>
                                                    <% } else { %>
                                                        <button disabled
                                                            class="w-full bg-gray-200 text-gray-400 py-2.5 rounded-xl text-sm font-semibold cursor-not-allowed">
                                                            Out of Stock
                                                        </button>
                                                        <% } %>
                                            </div>
                                        </div>
                            </div>
                            <% }) %>
                    </div>

                    <!-- Pagination Controls -->
                    <% if (totalPages> 1) { %>
                        <div class="mt-12 flex justify-center items-center gap-4">
                            <% if (currentPage> 1) { %>
                                <a href="/shop?category=<%= currentCategory %>&sortby=<%= currentSort %>&search=<%= searchQuery %>&page=<%= currentPage - 1 %>"
                                    class="px-5 py-2.5 bg-white border border-gray-200 text-gray-700 rounded-xl hover:bg-gray-50 transition-colors shadow-sm font-semibold flex items-center gap-1"><i
                                        class="ri-arrow-left-s-line"></i> Prev</a>
                                <% } %>

                                    <div
                                        class="px-5 py-2.5 text-gray-700 font-bold bg-white border border-gray-100 rounded-xl shadow-sm">
                                        Page <%= currentPage %> of <%= totalPages %>
                                    </div>

                                    <% if (currentPage < totalPages) { %>
                                        <a href="/shop?category=<%= currentCategory %>&sortby=<%= currentSort %>&search=<%= searchQuery %>&page=<%= currentPage + 1 %>"
                                            class="px-5 py-2.5 bg-white border border-gray-200 text-gray-700 rounded-xl hover:bg-gray-50 transition-colors shadow-sm font-semibold flex items-center gap-1">Next
                                            <i class="ri-arrow-right-s-line"></i></a>
                                        <% } %>
                        </div>
                        <% } %>

                            <% } else { %>
                                <!-- Empty State -->
                                <div
                                    class="w-full flex flex-col items-center justify-center bg-white rounded-3xl p-16 border border-dashed border-gray-300 text-center flex-1">
                                    <div
                                        class="w-24 h-24 bg-gray-50 rounded-full flex items-center justify-center mb-6">
                                        <i class="ri-search-eye-line text-4xl text-gray-400"></i>
                                    </div>
                                    <h2 class="text-2xl font-bold text-gray-800 mb-2">No Products Found</h2>
                                    <p class="text-gray-500 max-w-md mx-auto mb-8">We couldn't find any items
                                        matching
                                        your current filters. Try removing some filters or searching for
                                        something else.
                                    </p>
                                    <a href="/shop"
                                        class="bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-full font-medium transition-colors inline-block">
                                        Clear Filters
                                    </a>
                                </div>
                                <% } %>

            </main>
        </div>
    </div>

    <script>
        const h = new Date().getHours();
        const greet = h < 12 ? 'Good Morning ☀️' : h < 17 ? 'Good Afternoon 🌤️' : 'Good Evening 🌙';
        document.getElementById('greeting-time').textContent = greet;
    </script>

    <%- include('./partials/footer') %>