<%- include('./partials/header') %>

    <div class="min-h-screen bg-gray-50/50 flex flex-col pt-24 pb-20">
        <div class="max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8">

            <!-- Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
                <div>
                    <a href="/orders/my-orders"
                        class="text-sm font-medium text-blue-600 hover:text-blue-700 flex items-center gap-1 mb-3 transition-colors w-fit">
                        <i class="ri-arrow-left-line"></i> Back to Orders
                    </a>
                    <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight flex items-center gap-3">
                        Order Details
                    </h1>
                    <p class="text-gray-500 mt-2 text-sm font-medium">Order #<span
                            class="font-mono text-gray-700 uppercase">
                            <%= order._id %>
                        </span></p>
                </div>

                <div class="flex items-center gap-3">
                    <button onclick="window.print()"
                        class="bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-semibold py-2 px-5 rounded-xl shadow-sm transition-all text-sm flex items-center gap-2">
                        <i class="ri-printer-line text-lg"></i> Print Invoice
                    </button>
                </div>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 items-start">

                <!-- Left Side: Order Items -->
                <div class="w-full lg:w-2/3 flex flex-col gap-6">

                    <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="px-8 py-5 border-b border-gray-100 bg-gray-50/50">
                            <h2 class="text-lg font-bold text-gray-900">Items inside this order (<%=
                                    order.products.length %>)</h2>
                        </div>

                        <div class="p-8 flex flex-col gap-8">
                            <% order.products.forEach(function(item){ %>
                                <div
                                    class="flex flex-col sm:flex-row gap-6 items-start pb-8 border-b border-gray-100 border-dashed last:border-0 last:pb-0">

                                    <!-- Product Image -->
                                    <div
                                        class="w-full sm:w-40 shrink-0 bg-gray-50 rounded-2xl flex items-center justify-center p-4 border border-gray-100">
                                        <% if(item.image) { %>
                                            <img class="w-full h-32 object-contain hover:scale-105 transition-transform duration-500"
                                                src="data:image/jpeg;base64,<%= item.image.toString('base64') %>">
                                            <% } else { %>
                                                <div class="w-full h-32 flex items-center justify-center text-gray-300">
                                                    <i class="ri-image-2-line text-4xl"></i>
                                                </div>
                                                <% } %>
                                    </div>

                                    <!-- Product Details -->
                                    <div class="flex-1 flex flex-col h-full w-full">
                                        <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">
                                            <%= item.name %>
                                        </h3>

                                        <div class="mt-auto grid grid-cols-2 sm:grid-cols-3 gap-6 pt-4 w-full">
                                            <div>
                                                <span
                                                    class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Price</span>
                                                <span class="font-semibold text-gray-800">₹ <%=
                                                        item.price.toLocaleString() %></span>
                                            </div>
                                            <div>
                                                <span
                                                    class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Quantity</span>
                                                <span class="font-semibold text-gray-800">x <%= item.quantity %></span>
                                            </div>
                                            <div>
                                                <span
                                                    class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Subtotal</span>
                                                <span class="font-bold text-gray-900">₹ <%= (item.price *
                                                        item.quantity).toLocaleString() %></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                </div>

                <!-- Right Side: Order Summary & Info -->
                <div class="w-full lg:w-1/3 flex flex-col gap-6">

                    <!-- Summary Box -->
                    <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-lg shadow-gray-200/40">
                        <h2 class="text-xl font-bold text-gray-900 mb-6 flex items-center gap-2">
                            <i class="ri-file-list-3-line text-blue-500"></i> Order Summary
                        </h2>

                        <div class="flex flex-col gap-4 mb-6 text-sm">

                            <div class="flex justify-between items-center text-gray-600 font-medium">
                                <span>Ordered On</span>
                                <span class="text-gray-900">
                                    <%= new Date(order.createdAt || Date.now()).toDateString() %>
                                </span>
                            </div>

                            <% let oStatusClass="text-yellow-700 bg-yellow-100" ; if(order.orderStatus==='Shipped' )
                                oStatusClass="text-blue-700 bg-blue-100" ; if(order.orderStatus==='Packed' )
                                oStatusClass="text-indigo-700 bg-indigo-100" ; if(order.orderStatus==='Delivered' )
                                oStatusClass="text-green-700 bg-green-100" ; if(order.orderStatus==='Cancelled' )
                                oStatusClass="text-red-700 bg-red-100" ; let pStatusClass="text-gray-700 bg-gray-100" ;
                                if(order.paymentStatus==='Paid' ) pStatusClass="text-green-700 bg-green-100" ; %>

                                <div class="flex justify-between items-center text-gray-600 font-medium">
                                    <span>Order Status</span>
                                    <span
                                        class="px-2.5 py-1 text-xs font-bold uppercase tracking-wider rounded-md <%= oStatusClass %>">
                                        <%= order.orderStatus %>
                                    </span>
                                </div>

                                <div
                                    class="flex justify-between items-center text-gray-600 font-medium pb-4 border-b border-gray-100">
                                    <span>Payment Status</span>
                                    <span
                                        class="px-2.5 py-1 text-xs font-bold uppercase tracking-wider rounded-md <%= pStatusClass %>">
                                        <%= order.paymentStatus %>
                                    </span>
                                </div>

                                <div class="flex justify-between items-end mt-2">
                                    <span class="text-base font-bold text-gray-900">Grand Total</span>
                                    <span class="block text-3xl font-extrabold text-gray-900 tracking-tight">₹ <%=
                                            order.totalPrice.toLocaleString() %></span>
                                </div>
                        </div>
                    </div>

                    <!-- Delivery Info Mock Box -->
                    <div
                        class="bg-blue-600 border border-blue-500 rounded-3xl p-8 shadow-lg shadow-blue-600/30 text-white relative overflow-hidden">
                        <!-- Decor element -->
                        <i class="ri-truck-line absolute -right-6 -bottom-6 text-9xl text-white/10 rotate-[-15deg]"></i>

                        <h2 class="text-xl font-bold mb-6 flex items-center gap-2 relative z-10">
                            <i class="ri-map-pin-line text-blue-200"></i> Delivery Information
                        </h2>

                        <div class="relative z-10 space-y-6">
                            <div>
                                <span
                                    class="block text-xs font-bold text-blue-200 uppercase tracking-wider mb-1.5">Expected
                                    Delivery</span>
                                <% if(order.orderStatus==='Delivered' ) { %>
                                    <p class="text-white font-semibold">Delivered successfully</p>
                                    <% } else if(order.orderStatus==='Cancelled' ) { %>
                                        <p class="text-white font-semibold">Order Cancelled</p>
                                        <% } else { %>
                                            <p class="text-white font-semibold flex items-center gap-2">
                                                <i class="ri-timer-line"></i> Within 4-5 Business Days
                                            </p>
                                            <% } %>
                            </div>

                            <div>
                                <span
                                    class="block text-xs font-bold text-blue-200 uppercase tracking-wider mb-1.5">Shipping
                                    Address</span>
                                <p class="text-blue-50 font-medium text-sm leading-relaxed">
                                    <%= order.user?.fullname || 'Customer Name' %><br>
                                        123 Secure Building, Apartment 4B<br>
                                        Smart City District, Node Avenue<br>
                                        MERN State, 100010
                                </p>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <%- include('./partials/footer') %>