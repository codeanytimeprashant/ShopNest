<%- include('./partials/header') %>

    <div class="min-h-screen bg-gray-50/50 flex flex-col justify-center items-center py-20 px-4">
        <div class="max-w-md w-full bg-white rounded-3xl border border-gray-100 p-8 shadow-xl text-center space-y-6">

            <!-- Failure check -->
            <div class="mx-auto w-24 h-24 bg-red-50 rounded-full flex items-center justify-center shadow-inner">
                <span class="text-5xl text-red-500 font-bold">✕</span>
            </div>

            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Payment Failed</h1>
            <p class="text-gray-500 font-medium leading-relaxed">
                We couldn't process your transaction. This might be due to incorrect details, insufficient funds, or
                network timeouts.
            </p>

            <div class="flex flex-col gap-3 pt-4">
                <a href="/orders/my-orders"
                    class="w-full bg-red-650 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-all text-center"
                    style="background-color: #dc2626; color: white;">
                    Go to My Orders to Retry
                </a>
                <a href="/shop"
                    class="w-full bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-semibold py-3 px-6 rounded-xl transition-all text-center">
                    Return to Shop
                </a>
            </div>

        </div>
    </div>

    <%- include('./partials/footer') %>