<%- include('./partials/header') %>

    <div class="min-h-screen bg-gray-50/50 flex flex-col justify-center items-center py-20 px-4">
        <div class="max-w-md w-full bg-white rounded-3xl border border-gray-100 p-8 shadow-xl text-center space-y-6">

            <!-- Success checkmark -->
            <div class="mx-auto w-24 h-24 bg-green-50 rounded-full flex items-center justify-center shadow-inner">
                <span class="text-5xl text-green-500 animate-pulse">✓</span>
            </div>

            <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Payment Successful!</h1>
            <p class="text-gray-500 font-medium leading-relaxed">
                Your transaction has been securely processed. We've placed your order and will start packing it shortly!
            </p>

            <% if (typeof orderId !=='undefined' && orderId) { %>
                <div class="bg-gray-50 border border-gray-105 rounded-xl p-4 text-left">
                    <span class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-0.5">Order
                        ID</span>
                    <span class="font-mono text-xs font-semibold text-gray-700 uppercase block select-all">
                        <%= orderId %>
                    </span>
                </div>
                <% } %>

                    <div class="flex flex-col gap-3 pt-4">
                        <a href="/orders/my-orders"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-all text-center">
                            Track My Orders
                        </a>
                        <a href="/shop"
                            class="w-full bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 font-semibold py-3 px-6 rounded-xl transition-all text-center">
                            Continue Shopping
                        </a>
                    </div>

        </div>
    </div>

    <%- include('./partials/footer') %>