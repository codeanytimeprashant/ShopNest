<%- include('./partials/header') %>

    <div class="min-h-screen bg-gray-50/50 flex flex-col pt-20 pb-20">
        <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 mt-10">

            <div class="flex justify-between items-center mb-8">
                <h1 class="text-3xl font-extrabold text-gray-900 font-sans tracking-tight">Admin Dashboard</h1>
                <div class="flex gap-3">
                    <a href="/owners/admin/inventory"
                        class="border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 px-5 py-2.5 rounded-xl font-semibold text-sm transition-colors flex items-center gap-2">
                        <i class="ri-box-3-line"></i> Inventory
                    </a>
                    <a href="/owners/admin/orders"
                        class="bg-gray-900 hover:bg-black text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition-colors shadow-md">
                        Manage Orders
                    </a>
                </div>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                <!-- Total Revenue -->
                <div
                    class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm flex flex-col hover:shadow-md transition-shadow">
                    <span class="text-gray-500 font-bold uppercase tracking-wider text-xs mb-2">Total Revenue</span>
                    <span class="text-4xl font-extrabold text-gray-900">₹ <%= totalRevenue.toLocaleString() %></span>
                </div>
                <!-- Total Orders -->
                <div
                    class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm flex flex-col hover:shadow-md transition-shadow">
                    <span class="text-gray-500 font-bold uppercase tracking-wider text-xs mb-2">Total Orders</span>
                    <span class="text-4xl font-extrabold text-gray-900">
                        <%= totalOrders %>
                    </span>
                </div>
                <!-- Total Users -->
                <div
                    class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm flex flex-col hover:shadow-md transition-shadow">
                    <span class="text-gray-500 font-bold uppercase tracking-wider text-xs mb-2">Total Users</span>
                    <span class="text-4xl font-extrabold text-gray-900">
                        <%= totalUsers %>
                    </span>
                </div>
            </div>

            <!-- Recent Orders -->
            <h2 class="text-2xl font-bold text-gray-900 mb-6 font-sans">Recent Orders</h2>

            <div class="bg-white rounded-3xl border border-gray-100 shadow-sm overflow-hidden">
                <% if (recentOrders.length===0) { %>
                    <div class="p-10 text-center text-gray-500">No orders found.</div>
                    <% } else { %>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-gray-50/50 border-b border-gray-100">
                                        <th class="p-6 font-bold text-gray-900 tracking-wide text-sm">Order ID</th>
                                        <th class="p-6 font-bold text-gray-900 tracking-wide text-sm">Customer</th>
                                        <th class="p-6 font-bold text-gray-900 tracking-wide text-sm">Amount</th>
                                        <th class="p-6 font-bold text-gray-900 tracking-wide text-sm">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentOrders.forEach(order=> { %>
                                        <tr class="border-b border-gray-100/50 hover:bg-gray-50/30 transition-colors">
                                            <td class="p-6 text-sm font-medium text-gray-600">
                                                <%= order._id.toString().substring(0,8) %>...
                                            </td>
                                            <td class="p-6 text-sm font-semibold text-gray-900">
                                                <%= order.user ? order.user.fullname : 'Guest' %>
                                            </td>
                                            <td class="p-6 text-sm font-bold text-gray-900">₹ <%=
                                                    order.totalPrice.toLocaleString() %>
                                            </td>
                                            <td class="p-6">
                                                <span
                                                    class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide
                                            <%= order.orderStatus === 'Delivered' ? 'bg-green-100 text-green-700' : (order.orderStatus === 'Cancelled' ? 'bg-red-100 text-red-700' : 'bg-blue-100 text-blue-700') %>">
                                                    <%= order.orderStatus %>
                                                </span>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <% } %>
            </div>

        </div>
    </div>

    <%- include('./partials/footer') %>